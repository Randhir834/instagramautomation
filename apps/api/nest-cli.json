{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.json",
    "deleteOutDir": false,
    "assets": [
      { "include": "**/*.hbs", "watchAssets": true },
      { "include": "modules/email/templates/**/*", "watchAssets": true }
    ]
  }
}
